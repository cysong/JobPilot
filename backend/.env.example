# Environment
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobpilot

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-string

# AI Configuration
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxx
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TRACING_ENABLED=True
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io/v1
MINIMAX_TRACING_ENABLED=False
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# App
APP_TIMEZONE=Pacific/Auckland
APP_FRONTEND_URL=http://localhost:5173

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Optional celery tuning
CELERY_LOGLEVEL=info
CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=4
CELERY_PREFETCH_MULTIPLIER=1
DISABLE_BEAT_TASKS=false
JOB_ANALYSIS_LOOKBACK_DAYS=7

# AWS Function API
ENQUEUE_API_URL=
ENQUEUE_API_KEY=

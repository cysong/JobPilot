# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobpilot

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# User Defaults
DEFAULT_USER_ROLE=USER

# User Limits (by role)
USER_FORMAL_RESUME_LIMIT=3
VIP_FORMAL_RESUME_LIMIT=10
USER_MONTHLY_APPLICATION_LIMIT=20

# AI Configuration
OPENAI_API_KEY=sk-xxxxx
OPENAI_API_BASE=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Job Analysis
JOB_ANALYSIS_INTERVAL_HOURS=1
JOB_ANALYSIS_LOOKBACK_DAYS=7

# Matching
MATCH_SCORE_THRESHOLD=0.6
HIGH_MATCH_THRESHOLD=0.9

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Environment
ENVIRONMENT=development
DEBUG=False

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

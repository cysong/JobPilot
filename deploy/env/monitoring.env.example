# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_strong_password

# Grafana SMTP (for built-in alert email notifications)
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your_email@gmail.com
GF_SMTP_PASSWORD=your_app_password
GF_SMTP_FROM_ADDRESS=your_email@gmail.com
GF_SMTP_FROM_NAME=JobPilot Monitoring

# Grafana server (set to match your domain for reverse proxy)
GF_SERVER_ROOT_URL=https://api.freeclaw.cloud/grafana
GF_SERVER_SERVE_FROM_SUB_PATH=true

# Alertmanager reuses the GF_SMTP_* variables above (same Gmail account).
# At startup the alertmanager container writes $GF_SMTP_PASSWORD to a secret
# file that alertmanager.yml reads via `auth_password_file`. The Gmail
# address is hardcoded in alertmanager.yml — update both if it changes.

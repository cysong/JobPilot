# Backend runtime
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
LOG_DIR=logs

# Security
SECRET_KEY=replace-with-strong-random-secret

# Database (Supabase, SSL required)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require

# Redis (internal docker network)
REDIS_URL=redis://jobpilot-redis:6379/0

# CORS (must match frontend domain)
CORS_ORIGINS=["https://app.jobpilot.me"]

# AI
OPENAI_API_KEY=replace-with-real-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional celery tuning
CELERY_LOGLEVEL=info
CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=4
CELERY_PREFETCH_MULTIPLIER=1

# Backend runtime
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
LOG_DIR=logs

# Security
SECRET_KEY=replace-with-strong-random-secret

# Database (Supabase Session Pooler, SSL required)
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require&prepared_statement_cache_size=0

# Redis (internal docker network)
REDIS_URL=redis://jobpilot-redis:6379/0

# CORS (must match frontend domain)
CORS_ORIGINS=["https://app.freeclaw.cloud"]

# AI
OPENAI_API_KEY=replace-with-real-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional celery tuning
CELERY_LOGLEVEL=info
CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=4
CELERY_PREFETCH_MULTIPLIER=1
